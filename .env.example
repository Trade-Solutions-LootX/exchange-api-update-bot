# ─────────────────────────────────────────────────────────────────────────────
# exchange-api-update-bot configuration
# Copy to `.env` and fill in the required values.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — Telegram delivery -------------------------------------------------
# Create a bot with @BotFather to get the token.
# Get your chat id by messaging @userinfobot, or use a channel id like -1001234567890.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Optional knobs (defaults shown)
# ─────────────────────────────────────────────────────────────────────────────

# How often each feed is polled. Minimum 10s.
POLL_INTERVAL=5m

# Where the "already delivered" set is stored (mounted volume in Docker).
STATE_PATH=/data/state.json

# On first run, send the newest N items per feed as a labelled "backfill" so you
# can confirm the pipeline works, then only deliver genuinely new items.
SEND_HISTORY_ON_START=true
HISTORY_COUNT=1

# Only deliver items at or above this importance: low | medium | high | critical.
# Use "medium" to cut promotional noise; "critical" for API-breaking changes only.
MIN_IMPORTANCE=low

# API_ONLY=true delivers ONLY API-related announcements (deprecations, endpoint/
# websocket/auth/rate-limit changes) and drops listings, delistings, promos, and
# maintenance. Set this if you only care about API changes.
API_ONLY=false

# Limit which sources to poll (comma-separated). Empty = all.
# Exchanges: binance,okx,bybit,bitget,kucoin,bingx,mexc,gate,hyperliquid,aster,lighter,huobi
# Hosting providers (status + maintenance): render,digitalocean,vultr
ENABLED_EXCHANGES=

# ── Hosting-provider billing (OPTIONAL) ──────────────────────────────────────
# If set, the bot polls the provider's balance API and posts a once-daily
# summary (flagged HIGH when there's an outstanding amount to pay).
# DigitalOcean: create a read token at cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_API_TOKEN=
# Vultr: create an API key at my.vultr.com/settings/#settingsapi
VULTR_API_KEY=
# Render: dashboard.render.com/u/settings/api-keys (rnd_...). Render has NO
# balance API — /balance lists your services and points to the dashboard.
RENDER_API_KEY=
# How often to poll billing (deduped to one message per day regardless).
BILLING_INTERVAL=6h

# ── Server monitoring via each box's /v1/system/metrics handle ────────────────
# Reuses the same bearer-authed endpoint your trading-terminal servers expose.
# Format: "name|baseurl|token" entries separated by ';'. Alerts on CPU/RAM/disk
# thresholds + unreachable; /servers shows live metrics on demand.
# e.g. SERVER_METRICS=oi|https://oi-funding.lootx.trade|TOKEN;clusters|http://clusters.lootx.trade:8080|TOKEN
SERVER_METRICS=
SERVER_INTERVAL=60s
SERVER_TIMEOUT=10s
LOAD_DISK_PERCENT=90

# Log to stdout instead of sending to Telegram (great for a first local test).
DRY_RUN=false

# Health endpoint (used by the Docker healthcheck). Empty disables it.
HEALTH_ADDR=:8080

# Outbound HTTP timeout per request.
HTTP_TIMEOUT=20s

# log level: debug | info | warn | error
LOG_LEVEL=info

# ── Feed self-monitoring ──────────────────────────────────────────────────────
# Alert in Telegram if a source fails this many polls in a row (0 = disable) —
# catches an exchange changing its API before you notice silence.
FEED_FAILURE_ALERT=12
FEED_RECOVERY_NOTICE=true

# ── Uptime monitoring of YOUR endpoints ───────────────────────────────────────
# Comma list of "name=url" (or bare "url"). Alerts on down + recovery w/ latency.
# e.g. UPTIME_TARGETS=api=https://api.myapp.com/health,web=https://myapp.com
UPTIME_TARGETS=
UPTIME_INTERVAL=60s
UPTIME_TIMEOUT=10s

# ── Provider load monitoring (DigitalOcean; needs DIGITALOCEAN_API_TOKEN) ──────
# Requires the DO monitoring agent on the droplets. Alerts when CPU/RAM cross the
# threshold and again when they return to normal.
LOAD_MONITORING=false
LOAD_CPU_PERCENT=85
LOAD_MEM_PERCENT=90
LOAD_INTERVAL=5m
